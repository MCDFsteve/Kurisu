"AppBuild"
{
    "AppID" "3034460" // 您的 AppID
    "Desc" "All platforms build." // 此生成版本的内部描述

    "BuildOutput" "../output/" // 生成版本日志和生成版本缓存文件的生成版本输出文件夹

    "Depots"
    {
        "3034461" // macOS DepotID
        {
            "oslist" "macos"
            "ContentRoot" "../dist/mac-universal/" // macOS 内容根文件夹
            "FileMapping"
            {
                "LocalPath" "*" // 来自内容根文件夹的所有文件
                "DepotPath" "." // 映射到 depot 的根目录
                "recursive" "1" // 包含所有子文件夹
            }
        }
        
        "3034462" // Linux DepotID
        {
            "oslist" "linux"
            "ContentRoot" "../dist/linux-unpacked/" // Linux 内容根文件夹
            "FileMapping"
            {
                "LocalPath" "*" // 来自内容根文件夹的所有文件
                "DepotPath" "." // 映射到 depot 的根目录
                "recursive" "1" // 包含所有子文件夹
            }
        }
        
        "3034463" // Windows DepotID
        {
            "oslist" "windows"
            "ContentRoot" "../dist/win-unpacked/" // Windows 内容根文件夹
            "FileMapping"
            {
                "LocalPath" "*" // 来自内容根文件夹的所有文件
                "DepotPath" "." // 映射到 depot 的根目录
                "recursive" "1" // 包含所有子文件夹
            }
        }
    }
} 